# Worker configuration — in production these are GitHub Actions Secrets
# (Settings → Secrets and variables → Actions on the repo), never files.
# This .env.example is only a reference for local `npm run cycle` testing.
# Without any of these set, the worker still runs correctly: Alessia (and
# anything downstream) simply reports an honest BLOCKED state.

# --- TikTok Shop Affiliate API ---
# From partner.tiktokshop.com after registering an app + OAuth authorization
# for your own seller/affiliate account.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_CIPHER=
# Exact endpoint base/paths — fill in once confirmed against the current
# Partner Center Affiliate API reference (this repo never guesses them).
TIKTOK_API_BASE_URL=
TIKTOK_API_PRODUCTS_SEARCH_PATH=
TIKTOK_API_ORDERS_SEARCH_PATH=
TIKTOK_API_PERFORMANCE_PATH=

# --- Trend research (Tommaso) ---
# Any REST search API that accepts ?q=<query> and returns { results: [{title,snippet,url}] }.
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_API_KEY_HEADER=Authorization

# --- Media storage (set automatically by GitHub Actions, only needed
# locally if you want Riccardo's videos uploaded instead of kept on disk) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
