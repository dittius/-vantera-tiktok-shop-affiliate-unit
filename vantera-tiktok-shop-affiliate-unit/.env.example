# Frontend build-time config — all optional, everything has a working
# default that points at this project's own repo. Only needed if you fork
# this repo or deploy from a different owner/repo/branch.
#
# Vite only exposes vars prefixed with VITE_ to client code. None of these
# are secrets — they just tell the PWA which repo to read real state from.
VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=
VITE_GITHUB_BRANCH=
VITE_BASE_PATH=

# ---------------------------------------------------------------------------
# Real credentials (TikTok Shop, search API) are SERVER-SIDE ONLY and never
# belong in this file or in this frontend project. They are configured as
# GitHub Actions Secrets on the repository (Settings → Secrets and
# variables → Actions) and are read exclusively by the worker in
# vantera-tiktok-shop-affiliate-unit/server — see that folder's own
# .env.example for the full list and README.md for how to obtain them.
# ---------------------------------------------------------------------------
