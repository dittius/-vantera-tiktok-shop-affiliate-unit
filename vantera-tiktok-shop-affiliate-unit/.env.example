# TikTok Shop — RealTikTokShopProvider configuration
#
# None of these are required to run the app: without them the unit simply
# reports TikTok Shop status as "Not connected" and Earnings stays at 0.
# Never commit a real .env file with actual credentials.
#
# Vite only exposes vars prefixed with VITE_ to client code.
VITE_TIKTOK_APP_KEY=
VITE_TIKTOK_APP_SECRET=
VITE_TIKTOK_ACCESS_TOKEN=
VITE_TIKTOK_SHOP_ID=
